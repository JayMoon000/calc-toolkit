{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*.html",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/real-estate",
      "destination": "/ko/real-estate",
      "permanent": true
    },
    {
      "source": "/salary",
      "destination": "/ko/salary",
      "permanent": true
    },
    {
      "source": "/hourly",
      "destination": "/ko/hourly",
      "permanent": true
    },
    {
      "source": "/severance",
      "destination": "/ko/severance",
      "permanent": true
    },
    {
      "source": "/savings",
      "destination": "/ko/savings",
      "permanent": true
    },
    {
      "source": "/converter",
      "destination": "/tools/converter",
      "permanent": true
    },
    {
      "source": "/game-2048",
      "destination": "/tools/game-2048",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/legal/about",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/legal/contact",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/legal/privacy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal/terms",
      "permanent": true
    }
  ]
}