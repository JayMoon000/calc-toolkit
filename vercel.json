{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:slug*",
      "destination": "https://ko.starsign16.com/:year/:month/:slug*/",
      "permanent": true
    },
    {
      "source": "/category/:slug*",
      "destination": "https://ko.starsign16.com/category/:slug*/",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "https://ko.starsign16.com/contact-us/",
      "permanent": true
    },
    {
      "source": "/starsign-16-임시로고",
      "destination": "https://ko.starsign16.com/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/hourly", "destination": "/hourly.html" }
  ]
}